{
  "name": "@vfs-link/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev --host 0.0.0.0",
    "build": "tsc --noEmit && (react-router build || node scripts/generate-spa-fallback.mjs)",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"app/**/*.{ts,tsx}\" --max-warnings=0",
    "test": "vitest run app",
    "format": "prettier --write \"app/**/*.{ts,tsx,css,json,md}\" \"*.{json,md,js,cjs,ts}\""
  },
  "nx": {
    "name": "web",
    "targets": {
      "dev": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm --dir apps/web dev"
        }
      },
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm --dir apps/web build"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm --dir apps/web typecheck"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm --dir apps/web lint"
        }
      }
    }
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@react-router/fs-routes": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@zip.js/zip.js": "^2.8.34",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5",
    "lodash-es": "^4.17.21",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.8.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^2.6.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^7.3.5",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
