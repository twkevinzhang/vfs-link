{
  "name": "@vfs-link/ftp-server",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "ftp-server",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "cd apps/ftp-server && ./scripts/go.sh build ./cmd/ftp-server"
        }
      },
      "docker": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "commands": [
            "docker build -t vfs-link/ftp-server:latest -f apps/ftp-server/Dockerfile ."
          ],
          "parallel": false
        }
      },
      "up": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "docker"
        ],
        "options": {
          "commands": [
            "docker-compose up -d"
          ],
          "parallel": false
        }
      },
      "rebuild-mapping": {
        "executor": "nx:run-commands",
        "options": {
          "command": "docker exec -it vfs-link ./ftp-server rebuild-mapping"
        }
      }
    }
  }
}
