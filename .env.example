# FTP Server Configuration
FTP_USER=admin
FTP_PASS=admin123
FTP_PORT=21
FTP_PASV_URL=127.0.0.1
FTP_PASV_MIN=30000
FTP_PASV_MAX=30005

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vfs_link?schema=public"

# Primary Storage Configuration
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./data/objects
# Required when STORAGE_DRIVER=gcs
GCS_BUCKET=your-bucket-name

# File Sharing Configuration (independent from primary storage)
SHARE_GCS_BUCKET=your-share-bucket-name
SHARE_GCS_PREFIX=shares
SHARE_PUBLIC_BASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Cloud authentication for GCS primary storage and/or file sharing
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-key.json
