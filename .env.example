# Copy this file to .env and replace every value marked CHANGE_ME.

# PostgreSQL used by docker-compose.yml
POSTGRES_USER=vfs_link
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=vfs_link

# Metadata database. postgres preserves the SQL implementation. json stores a
# tree of small JSON objects on an independent local or GCS metadata backend.
DB_DRIVER=postgres
DATABASE_URL=
METADATA_STORAGE_DRIVER=local
METADATA_LOCAL_ROOT=./data/metadata
METADATA_GCS_BUCKET=
METADATA_PREFIX=_vfs-link

# File server protocol switches. Keep FTP enabled during migration; set
# FTP_ENABLED=false for an HTTP-only serverless deployment.
FTP_ENABLED=true

# Transitional FTP endpoint
FTP_USER=vfs_link
FTP_PASS=CHANGE_ME_FTP_PASSWORD
FTP_PORT=21
# Use a publicly reachable DNS name or IP for remote FTP clients.
FTP_PASV_URL=127.0.0.1
FTP_PASV_MIN=30000
FTP_PASV_MAX=30100
HTTP_PORT=8080

# Protect the browser and public HTTP API. Enable this for internet exposure.
HTTP_BASIC_AUTH_ENABLED=false
HTTP_BASIC_AUTH_USER=vfs_link
HTTP_BASIC_AUTH_PASS=CHANGE_ME_HTTP_APP_PASSWORD
HTTP_CORS_ORIGINS=
# Read-only mode for metadata migrations. GET/HEAD remain available; mutations
# and Pub/Sub push delivery return 503.
MAINTENANCE_MODE=false

# Browser uploads use create-session -> PUT uploadUrl -> complete for both
# local and GCS storage. 50 GiB in bytes; sessions live for one day.
UPLOAD_MAX_BYTES=53687091200
UPLOAD_SESSION_TTL=24h

# WebDAV over HTTPS. TLS terminates at the managed ingress or reverse proxy;
# the proxy must preserve X-Forwarded-Proto=https and all WebDAV methods.
WEBDAV_ENABLED=false
WEBDAV_PATH=/dav/
WEBDAV_USER=vfs_link
WEBDAV_PASS=CHANGE_ME_WEBDAV_APP_PASSWORD
WEBDAV_LOCK_TIMEOUT=30m
# Set true only when a trusted ingress overwrites X-Forwarded-Proto.
WEBDAV_TRUST_FORWARDED_HEADERS=false

# Primary storage. local is the default Compose setup.
# For Cloud Run or another stateless HTTP platform, use STORAGE_DRIVER=gcs and
# set GCS_BUCKET. With DB_DRIVER=json, also use METADATA_STORAGE_DRIVER=gcs and
# a separate Standard-class METADATA_GCS_BUCKET in the service region.
STORAGE_DRIVER=local
GCS_BUCKET=

# Optional file sharing. It needs GCS credentials and a destination bucket.
SHARE_GCS_BUCKET=
SHARE_GCS_PREFIX=shares
SHARE_PUBLIC_BASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Share job dispatcher. goroutine preserves the self-hosted legacy behavior;
# pubsub publishes jobs for authenticated push delivery to Cloud Run.
PUB_SUB_DRIVER=goroutine
GCP_PROJECT_ID=
PUB_SUB_TOPIC=
PUB_SUB_PUSH_AUDIENCE=
PUB_SUB_PUSH_SERVICE_ACCOUNT=

# Only used with docker-compose.gcs.yml. This is a host path and must never be committed.
GOOGLE_APPLICATION_CREDENTIALS_HOST=
