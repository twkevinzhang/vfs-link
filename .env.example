# Copy this file to .env and replace every value marked CHANGE_ME.

# PostgreSQL used by docker-compose.yml
POSTGRES_USER=vfs_link
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=vfs_link

# File server protocol switches. Keep FTP enabled during migration; set
# FTP_ENABLED=false for an HTTP-only serverless deployment.
FTP_ENABLED=true

# Transitional FTP endpoint
FTP_USER=vfs_link
FTP_PASS=CHANGE_ME_FTP_PASSWORD
FTP_PORT=21
# Use a publicly reachable DNS name or IP for remote FTP clients.
FTP_PASV_URL=127.0.0.1
FTP_PASV_MIN=30000
FTP_PASV_MAX=30100
HTTP_PORT=8080

# WebDAV over HTTPS. TLS terminates at the managed ingress or reverse proxy;
# the proxy must preserve X-Forwarded-Proto=https and all WebDAV methods.
WEBDAV_ENABLED=false
WEBDAV_PATH=/dav/
WEBDAV_USER=vfs_link
WEBDAV_PASS=CHANGE_ME_WEBDAV_APP_PASSWORD
WEBDAV_LOCK_TIMEOUT=30m
# Set true only when a trusted ingress overwrites X-Forwarded-Proto.
WEBDAV_TRUST_FORWARDED_HEADERS=false

# Primary storage. local is the default Compose setup.
# For Cloud Run or another stateless HTTP platform, use STORAGE_DRIVER=gcs,
# set GCS_BUCKET, provide DATABASE_URL separately, and set FTP_ENABLED=false.
STORAGE_DRIVER=local
GCS_BUCKET=

# Optional file sharing. It needs GCS credentials and a destination bucket.
SHARE_GCS_BUCKET=
SHARE_GCS_PREFIX=shares
SHARE_PUBLIC_BASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Only used with docker-compose.gcs.yml. This is a host path and must never be committed.
GOOGLE_APPLICATION_CREDENTIALS_HOST=
